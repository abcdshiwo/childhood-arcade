[Unit]
Description=Childhood Arcade web application
Documentation=https://github.com/abcdshiwo/childhood-arcade
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=childhood-arcade
Group=childhood-arcade
WorkingDirectory=/srv/childhood-arcade/current
EnvironmentFile=/etc/childhood-arcade.env
ExecStart=/srv/childhood-arcade/runtime/node-v24/bin/node server/index.js
Restart=always
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077

MemoryHigh=1536M
MemoryMax=2G
CPUQuota=200%
TasksMax=512
LimitNOFILE=65536

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/srv/childhood-arcade/shared/data
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
