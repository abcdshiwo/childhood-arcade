# Install as /etc/childhood-arcade.env with mode 0600.
NODE_ENV=production
HOST=127.0.0.1
PORT=19097

# These values are used only when the first user is seeded into a new database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

MAX_UPLOAD_BYTES=104857600
MAX_STATE_BYTES=8388608

# Keep every mutable path outside the immutable release directory.
DB_PATH=/srv/childhood-arcade/shared/data/app.db
UPLOADS_DIR=/srv/childhood-arcade/shared/data/uploads
BIOS_DIR=/srv/childhood-arcade/shared/data/bios
SAVES_DIR=/srv/childhood-arcade/shared/data/saves
CORES_DIR=/srv/childhood-arcade/shared/data/cores

# Immutable content objects, operator-reviewed manifests, and emitted audit evidence.
LIBRARY_ASSET_ROOT=/srv/childhood-arcade/shared/data/library-assets
LEGACY_LIBRARY_MANIFEST_PATH=/srv/childhood-arcade/shared/manifests/legacy-library.json
LIBRARY_EVIDENCE_ROOT=/srv/childhood-arcade/shared/evidence
